# Caddy for the game on the Raspberry Pi: static files only, on port 8080 (the playit tunnel
# points here). Installed as /etc/caddy/Caddyfile (tools/pi/README.md).
{
	admin off
	auto_https off
}

:8080 {
	root * /var/www/guardian
	encode gzip

	# Built files carry a content hash in their name: they never change, keep them a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (the page, the service worker, the data pack, icons) is checked again on
	# every visit, so a new version shows at once; unchanged files cost a short "not modified".
	@rest not path /assets/*
	header @rest Cache-Control "no-cache"

	@hidden path */.*
	respond @hidden 404

	# The newest from ARGUS for the first screen, written every 15 minutes by guardian-live
	# (tools/pi/guardian_live.py) outside the site's folder, which every new version replaces.
	handle_path /live/* {
		root * /var/lib/guardian-live/public
		file_server {
			hide .*
		}
	}

	file_server
}
