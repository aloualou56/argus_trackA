flowchart-elk TB
  classDef person fill:#0b5d4b,stroke:#08463a,stroke-width:1.5px,color:#ffffff
  classDef system fill:#1f4e8c,stroke:#163a69,stroke-width:2px,color:#ffffff
  classDef argus fill:#a84300,stroke:#7a3100,stroke-width:2px,color:#ffffff
  classDef ext fill:#8a94a3,stroke:#6b7280,stroke-width:1.5px,color:#ffffff
  classDef off fill:#ffffff,stroke:#9aa3ad,stroke-width:1.5px,stroke-dasharray:5 4,color:#4b5563
  classDef legend fill:#ffffff,stroke:#c9d1d9,stroke-width:1px,color:#1b2430

  PLAYER["<b>Player</b><br/>[Person]<br/>a student or a visitor, on a<br/>computer or a phone"]:::person
  TEACHER["<b>Teacher</b><br/>[Person]<br/>runs the game with a class"]:::person

  AEGIS["<b>Aegis</b><br/>[Software system]<br/>educational game: build a sensor network for a<br/>monument, face real ARGUS alarms, see ARGUS's<br/>latest risk checks and its 3D models"]:::system

  ARGUSAPI["<b>ARGUS API</b><br/>[External system, Athena Research Center]<br/>monuments, dangers, risk checks,<br/>alarms, sensors, decisions"]:::argus
  ARGUS3D["<b>ARGUS 3D data</b><br/>[External system, Athena Research Center]<br/>photogrammetric models and terrain"]:::argus
  GITHUB["<b>GitHub</b><br/>[External system]<br/>private repository, Actions (build),<br/>Pages (public website, HTTPS)"]:::ext
  MAPS["<b>Map and elevation tiles</b><br/>[External systems]<br/>Esri World Imagery, OpenStreetMap,<br/>AWS Terrain Tiles"]:::ext
  WIKI["<b>Wikimedia Commons</b><br/>[External system]<br/>openly licensed mosaic photos"]:::ext
  OSMAPI["<b>OpenStreetMap API</b><br/>[External system]<br/>outlines around each monument"]:::ext
  VOICE["<b>ElevenLabs</b><br/>[External system]<br/>recorded voices for read aloud"]:::ext
  SUPA["<b>Supabase</b><br/>[External system, optional]<br/>shared leaderboard<br/>not configured today"]:::off

  PLAYER -- "Plays in a web browser<br/>[HTTPS]" --> AEGIS
  TEACHER -- "Runs class sessions, optionally<br/>through a class server [HTTP, LAN]" --> AEGIS
  AEGIS -- "Reads monuments, dangers, risk checks,<br/>alarms, sensors, decisions<br/>[HTTP GET, JSON, read-only]" --> ARGUSAPI
  AEGIS -- "Reads models and terrain once<br/>[HTTPS GET + HEAD, read-only]" --> ARGUS3D
  AEGIS -- "Is built, tested and published by<br/>[git push, GitHub Actions, Pages]" --> GITHUB
  AEGIS -- "Loads map pictures and elevation<br/>while playing [HTTPS GET]" --> MAPS
  AEGIS -- "Loads mosaic photos in 3D<br/>[HTTPS GET]" --> WIKI
  AEGIS -- "Reads outlines once<br/>[HTTPS GET]" --> OSMAPI
  AEGIS -- "Records voices once<br/>[HTTPS API, paid account]" --> VOICE
  AEGIS -. "Would share scores<br/>[HTTPS, REST]" .-> SUPA

  subgraph KEY["Legend (C4 model, level 1: system context)"]
    direction LR
    K1["Person"]:::person
    K2["The system"]:::system
    K3["ARGUS (data owner)"]:::argus
    K4["Other external system"]:::ext
    K5["Optional, not in use"]:::off
  end
