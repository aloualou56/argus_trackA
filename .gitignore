# ARGUS API snapshot: snapshot/ IS committed (private repository) so both of us build from the
# same data. It is read-only input; the game itself only loads web/public/data/game_data.json.
# Do not make this repository public without checking the challenge's data terms.
snapshot.zip

# Never commit API scripts or credentials.
test_api.py
.env
*.token

# Python
__pycache__/
*.pyc

# Web
node_modules/
web/dist/

# Records kept by tools/class_server.py on the teacher's computer (anonymous, but a class's own).
class_data/

# Test clips from `npm run narration -- --sample` (to compare voices; not part of the game).
web/narration-samples/

# ARGUS 3D data as downloaded by tools/fetch_argus_3d.py (only the small result goes in the game)
argus_3d_cache/

# Local desktop metadata and LaTeX compiler output.
.DS_Store
docs/submission/**/*.aux
docs/submission/**/*.fdb_latexmk
docs/submission/**/*.fls
docs/submission/**/*.log
docs/submission/**/*.out
docs/submission/**/*.synctex.gz
docs/submission/**/main.pdf

# Generated distribution archives retained locally; source is available from GitHub.
/submissionPackage.zip
/submissionPackage/AEGIS_Source_Code.zip
/submissionPackage/Source_Manifest.json
